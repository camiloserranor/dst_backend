# Copy to .env for local development. Never commit .env.
PORT=8080
# Public URL of this backend. The MCP endpoint is PUBLIC_BASE_URL/mcp, and that exact URL
# must be registered as a Resource Indicator in WorkOS (see README "WorkOS setup").
PUBLIC_BASE_URL=http://localhost:8080

# WorkOS AuthKit domain (Dashboard → Domains), e.g. https://example-123.authkit.app
# Must match the tokens' "iss" claim exactly.
OIDC_ISSUER=https://your-subdomain.authkit.app
# Optional; discovered automatically. For AuthKit it is <OIDC_ISSUER>/oauth2/jwks
# OIDC_JWKS_URI=
# Audience of the web app's tokens. Defaults to PUBLIC_BASE_URL/api (register it as a
# second Resource Indicator), or set it to whatever "aud" WorkOS puts in the SPA's tokens.
# API_AUDIENCE=
CORS_ORIGINS=http://localhost:4200

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=general
DB_SSL=true
